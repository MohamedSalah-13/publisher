<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<BorderPane prefHeight="600.0" prefWidth="900.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hamzatech.publisher.controller.CategoriesController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="app-toolbar">
            <FontIcon iconLiteral="fth-tag" iconSize="18" styleClass="accent"/>
            <Label text="%categories.header" styleClass="accent, title-4">
                <font>
                    <Font name="System Bold" size="20.0"/>
                </font>
            </Label>
        </HBox>
    </top>

    <center>
        <HBox spacing="20.0" styleClass="content-area">

            <!-- القسم الأيسر: تصنيفات المدونات -->
            <VBox spacing="15.0" HBox.hgrow="ALWAYS" styleClass="surface-card">
                <Label text="%categories.blog.categories" styleClass="title-4" graphicTextGap="8">
                    <graphic><FontIcon iconLiteral="fth-folder" iconSize="18" styleClass="accent"/></graphic>
                    <font>
                        <Font name="System Bold" size="16.0"/>
                    </font>
                </Label>
                <Separator/>

                <!-- قائمة التصنيفات -->
                <ListView fx:id="categoriesList" prefHeight="300.0" VBox.vgrow="ALWAYS"/>

                <!-- نموذج إضافة/تعديل تصنيف -->
                <VBox spacing="10.0" styleClass="inset-panel">
                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                        <Label text="%categories.id" minWidth="60.0"/>
                        <TextField fx:id="txtCategoryId" promptText="%categories.id.prompt" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                        <Label text="%categories.name" minWidth="60.0"/>
                        <TextField fx:id="txtCategoryName" promptText="%categories.name.prompt" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                        <Label text="%categories.color" minWidth="60.0"/>
                        <ColorPicker fx:id="colorPicker"/>
                    </HBox>
                    <HBox spacing="10.0" alignment="CENTER_RIGHT">
                        <Button text="%categories.add.button" onAction="#handleAddCategory" styleClass="success">
                            <graphic><FontIcon iconLiteral="fth-plus"/></graphic>
                        </Button>
                        <Button text="%categories.update.button" onAction="#handleUpdateCategory" styleClass="warning">
                            <graphic><FontIcon iconLiteral="fth-edit-2"/></graphic>
                        </Button>
                        <Button text="%categories.delete.button" onAction="#handleDeleteCategory" styleClass="danger">
                            <graphic><FontIcon iconLiteral="fth-trash-2"/></graphic>
                        </Button>
                    </HBox>
                </VBox>
            </VBox>

            <!-- القسم الأيمن: ربط المدونات بالتصنيفات -->
            <VBox spacing="15.0" HBox.hgrow="ALWAYS" styleClass="surface-card">
                <Label text="%categories.link.blogs" styleClass="title-4" graphicTextGap="8">
                    <graphic><FontIcon iconLiteral="fth-link" iconSize="18" styleClass="accent"/></graphic>
                    <font>
                        <Font name="System Bold" size="16.0"/>
                    </font>
                </Label>
                <Separator/>

                <VBox spacing="10.0">
                    <Label text="%categories.select.category"/>
                    <ComboBox fx:id="cmbCategoryFilter" prefWidth="250.0"
                              promptText="%categories.select.category.prompt"/>

                    <Label text="%categories.select.blog" styleClass="field-group"/>
                    <ComboBox fx:id="cmbBlogToAssign" prefWidth="250.0" promptText="%categories.select.blog.prompt"/>

                    <HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="field-group">
                        <Button text="%categories.link.button" onAction="#handleAssignBlog" styleClass="accent">
                            <graphic><FontIcon iconLiteral="fth-link"/></graphic>
                        </Button>
                        <Button text="%categories.unlink.button" onAction="#handleUnassignBlog" styleClass="danger">
                            <graphic><FontIcon iconLiteral="fth-x"/></graphic>
                        </Button>
                    </HBox>
                </VBox>

                <Separator/>

                <!-- عرض المدونات المرتبطة -->
                <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                    <Label text="%categories.linked.blogs" styleClass="text-bold"/>
                    <ListView fx:id="assignedBlogsList" prefHeight="200.0"/>
                </VBox>
            </VBox>

        </HBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="app-toolbar">
            <Label fx:id="lblStatus" text="%categories.status.ready" styleClass="text-muted" HBox.hgrow="ALWAYS"/>
            <Button text="%categories.close.button" onAction="#handleClose" prefWidth="100.0"/>
        </HBox>
    </bottom>

</BorderPane>
