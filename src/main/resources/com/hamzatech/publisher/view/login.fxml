<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.hamzatech.publisher.controller.LoginController"
           prefHeight="500.0" prefWidth="400.0" styleClass="root-pane" stylesheets="@styles.css">

    <VBox alignment="CENTER" spacing="20.0" maxWidth="320" maxHeight="480" styleClass="login-card">

        <FontIcon iconLiteral="fth-globe" iconSize="40" styleClass="app-icon"/>

        <Label text="%app.title" styleClass="app-title, title-1">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <Label fx:id="lblWelcome" text="%login.welcome" styleClass="text-muted" wrapText="true"/>

        <VBox prefHeight="20.0" />

        <Button fx:id="btnLogin" onAction="#handleLogin" text="%login.button" styleClass="google-btn">
            <graphic>
                <FontIcon iconLiteral="fth-log-in" iconSize="16"/>
            </graphic>
        </Button>

        <VBox fx:id="loadingBox" alignment="CENTER" visible="false" managed="false" spacing="10">
            <ProgressIndicator maxWidth="30" maxHeight="30"/>
            <Label fx:id="lblConnecting" text="%login.connecting" styleClass="text-muted"/>
        </VBox>

        <Label fx:id="lblError" styleClass="danger" visible="false" wrapText="true"/>

        <Button onAction="#handleContinueWithoutGoogle" text="%login.skip" styleClass="flat"/>
        <Hyperlink onAction="#handleSetupWizard" text="%login.setup"/>

    </VBox>
</StackPane>
