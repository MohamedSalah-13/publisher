<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<BorderPane prefHeight="600.0" prefWidth="900.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hamzatech.publisher.controller.PublishQueueController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="app-toolbar">
            <FontIcon iconLiteral="fth-clock" iconSize="18" styleClass="accent"/>
            <Label text="%queue.header" styleClass="accent, title-4">
                <font>
                    <Font name="System Bold" size="20.0"/>
                </font>
            </Label>
        </HBox>
    </top>

    <center>
        <HBox spacing="20.0" styleClass="content-area">

            <!-- القسم الأيسر: الدفعات المتوقفة -->
            <VBox spacing="15.0" prefWidth="360.0" HBox.hgrow="ALWAYS" styleClass="surface-card">
                <Label text="%queue.jobs.header" styleClass="title-4" graphicTextGap="8">
                    <graphic><FontIcon iconLiteral="fth-layers" iconSize="18" styleClass="accent"/></graphic>
                    <font>
                        <Font name="System Bold" size="16.0"/>
                    </font>
                </Label>
                <Separator/>
                <ListView fx:id="jobsList" prefHeight="400.0" VBox.vgrow="ALWAYS">
                    <placeholder>
                        <Label text="%queue.jobs.empty"/>
                    </placeholder>
                </ListView>
            </VBox>

            <!-- القسم الأيمن: مقالات الدفعة المُختارة -->
            <VBox spacing="10.0" prefWidth="460.0" HBox.hgrow="ALWAYS" styleClass="surface-card">
                <Label text="%queue.items.header" styleClass="title-4" graphicTextGap="8">
                    <graphic><FontIcon iconLiteral="fth-list" iconSize="18" styleClass="accent"/></graphic>
                    <font>
                        <Font name="System Bold" size="16.0"/>
                    </font>
                </Label>
                <Separator/>
                <TableView fx:id="itemsTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colItemStatus" text="%queue.column.status" prefWidth="90"/>
                        <TableColumn fx:id="colItemTitle" text="%queue.column.title" prefWidth="340"/>
                    </columns>
                    <placeholder>
                        <Label text="%queue.select.job.hint"/>
                    </placeholder>
                </TableView>

                <HBox spacing="10.0" alignment="CENTER_RIGHT" styleClass="card-actions">
                    <Button fx:id="btnDiscard" onAction="#handleDiscard" text="%queue.discard.button" styleClass="danger">
                        <graphic><FontIcon iconLiteral="fth-trash-2"/></graphic>
                    </Button>
                    <Button fx:id="btnResume" onAction="#handleResume" text="%queue.resume.button" styleClass="accent">
                        <graphic><FontIcon iconLiteral="fth-play"/></graphic>
                    </Button>
                </HBox>
            </VBox>

        </HBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="app-toolbar">
            <Label fx:id="lblStatus" text="%queue.status.ready" styleClass="text-muted" HBox.hgrow="ALWAYS"/>
            <Button text="%categories.close.button" onAction="#handleClose"/>
        </HBox>
    </bottom>

</BorderPane>
